---
import '../styles/global.css';
import { site } from '../site.config.mjs';
import Logo from '../components/Logo.astro';
import { ui, href, barePath, type Lang } from '../i18n';
import { SITE, url } from '../lib/seo';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Breadcrumb trail after "Home": [label, root-relative path] pairs. */
  crumbs?: [string, string][];
  /** Extra schema.org objects for this page. */
  schema?: Record<string, unknown>[];
}
const { lang, title, noindex = false, crumbs = [], schema = [] } = Astro.props;
const image = Astro.props.image ?? new URL('/og.png', Astro.site).href;
const t = ui[lang];
const REPO_SLUG = site.repositorySlug;
const REPO = site.repository;
// Long titles drop the site suffix so the page's own words fit in a search result.
const fullTitle = title.includes(site.name) || title.length > 48 ? title : `${title} · ${site.name}`;
// No trailing slash: the host redirects /images/ to /images, and the canonical must name the final URL.
const bare = barePath(Astro.url.pathname).replace(/(.)\/+$/, '$1');
// Paginated list pages (/images/2, /category/x/3) get their page number in the description,
// so no two pages share one.
const pageNo = bare.match(/\/(\d+)$/)?.[1];
const description = (Astro.props.description ?? t.siteDesc) + (pageNo ? ` Page ${pageNo}.` : '');
const abs = (l: Lang) => new URL(href(l, bare), Astro.site);
const promptLinks = [
  { path: '/images', label: 'Image prompts', description: 'Find a visual starting point', icon: 'M4 4h16v16H4z M4 16l5-5 4 4 3-3 4 4 M8 8h.01' },
  { path: '/videos', label: 'Video prompts', description: 'Put your ideas in motion', icon: 'M3 5h13v14H3z M16 10l5-3v10l-5-3' },
  { path: '/text', label: 'Text prompts', description: 'Get past the blank page', icon: 'M5 5h14 M12 5v14 M8 19h8' },
];
const libraryLinks = [
  { path: '/skills', label: 'Agent skills' },
  { path: '/mcp-servers', label: 'MCP servers' },
];
const graphs: Record<string, unknown>[] = [...schema];
if (bare === '/') {
  graphs.push(
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: site.name,
      url: url(lang, '/'),
      inLanguage: lang,
      description,
      publisher: { '@id': `${SITE}/#org` },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${url(lang, '/search')}?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': `${SITE}/#org`,
      name: site.name,
      url: SITE,
      logo: `${SITE}/icon-512.png`,
      email: site.contactEmail,
      contactPoint: { '@type': 'ContactPoint', contactType: 'Site maintenance', email: site.contactEmail },
      member: { '@type': 'Person', name: site.maintainer },
      description: ui.en.siteDesc,
      sameAs: [REPO],
    },
  );
}
if (crumbs.length) {
  graphs.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [[site.name, '/'], ...crumbs].map(([name, path], i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name,
      item: url(lang, path),
    })),
  });
}
const ld = graphs.map((g) => JSON.stringify(g).replace(/</g, '\\u003c'));
const isOn = (p: string) =>
  (p === '/mcp' ? bare === p : bare.startsWith(p)) ||
  (p === '/images' && /^\/(category|prompt)\//.test(bare)) ||
  (p === '/videos' && /^\/video(?:\/|-model\/)/.test(bare)) ||
  (p === '/text' && bare.startsWith('/text-prompt'));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        let theme = 'dark';
        try { const saved = localStorage.getItem('promptsbaba-theme'); if (saved === 'light' || saved === 'dark') theme = saved; } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={abs(lang)} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" content="#0B0F17" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="help" type="text/plain" href="/llms.txt" title="llms.txt" />
    {!noindex && ld.map((json) => <script type="application/ld+json" set:html={json} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="header-brand" href="/" aria-label="PromptsBaba home"><Logo /></a>
        <nav class="desktop-nav" aria-label="Main">
          <details class="prompt-menu header-disclosure">
            <summary class:list={['nav-link', promptLinks.some(({ path }) => isOn(path)) && 'nav-active']}>
              Prompts
              <svg class="nav-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <div class="prompt-menu-items">
              {promptLinks.map(({ path, label, description, icon }) => (
                <a href={path} aria-current={isOn(path) ? (bare === path ? 'page' : 'true') : undefined}>
                  <span class="prompt-menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon} /></svg></span>
                  <span><strong>{label}</strong><small>{description}</small></span>
                </a>
              ))}
            </div>
          </details>
          {libraryLinks.map(({ path, label }) => <a class="nav-link" href={path} aria-current={isOn(path) ? (bare === path ? 'page' : 'true') : undefined}>{label}</a>)}
        </nav>
        <div class="header-actions">
          <a href="/search" class="search-shortcut" aria-label="Search the library" aria-current={bare === '/search' ? 'page' : undefined}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
            <span>Search</span><kbd aria-hidden="true">⌘ K</kbd>
          </a>
          <button type="button" id="theme-toggle" class="theme-button" aria-label="Switch to light theme" title="Switch to light theme">
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"/></svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M20 15A8 8 0 0 1 9 4a8 8 0 1 0 11 11Z"/></svg>
          </button>
          <a href="/mcp" class="header-connect" aria-current={bare === '/mcp' ? 'page' : undefined}>Connect agent</a>
          <details class="mobile-menu header-disclosure">
            <summary class="mobile-menu-toggle" aria-label="Navigation menu">
              <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
              <svg class="close-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
            </summary>
            <nav class="mobile-menu-panel" aria-label="Main">
              <div class="mobile-prompt-links">
                {promptLinks.map(({ path, label, icon }) => (
                  <a href={path} aria-current={isOn(path) ? (bare === path ? 'page' : 'true') : undefined}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon} /></svg>{label}
                  </a>
                ))}
              </div>
              <div class="mobile-library-links">
                {libraryLinks.map(({ path, label }) => <a href={path} aria-current={isOn(path) ? (bare === path ? 'page' : 'true') : undefined}>{label}</a>)}
              </div>
              <a href="/mcp" class="header-connect mobile-connect" aria-current={bare === '/mcp' ? 'page' : undefined}>Connect agent</a>
              <div class="mobile-secondary-links">
                <a href="/credits" aria-current={isOn('/credits') ? 'page' : undefined}>Credits &amp; sources</a>
                <a href={REPO} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
              </div>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main" class="flex-1"><slot /></main>
    <footer class="site-footer mt-24 border-t border-line">
      <div class="wrap grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
        <div><Logo size={34} /><p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">Free resources for making things with AI. Practical prompts, useful skills, MCP servers, and credit where it belongs.</p><p class="mt-5 text-sm font-semibold">{site.tagline}</p></div>
        <div><p class="font-semibold">Explore the library</p><ul class="mt-4 space-y-3 text-sm text-muted"><li><a href="/images">Image prompts</a></li><li><a href="/videos">Video prompts</a></li><li><a href="/text">Text prompts</a></li><li><a href="/skills">Agent skills</a></li><li><a href="/mcp-servers">MCP servers</a></li></ul></div>
        <div><p class="font-semibold">Made for sharing</p><ul class="mt-4 space-y-3 text-sm text-muted"><li><a href="/mcp">Connect your AI assistant</a></li><li><a href="/credits">Sources, licenses & credits</a></li><li><a href="/credits#removal">Request content removal</a></li><li><a href={REPO} target="_blank" rel="noopener noreferrer">Source code on GitHub ↗</a></li></ul></div>
      </div>
      <div class="wrap flex flex-wrap justify-between gap-3 border-t border-line py-5 text-xs text-muted"><span>Free to browse. No account. Open-source code.</span><span>PromptsBaba. Powered by people who share.</span></div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById('theme-toggle');
        const sync = () => {
          const dark = root.dataset.theme === 'dark';
          const label = dark ? 'Switch to light theme' : 'Switch to dark theme';
          button.setAttribute('aria-label', label); button.title = label;
          document.querySelector('meta[name="theme-color"]').content = dark ? '#0B0F17' : '#F8FAFC';
        };
        const themeStyle = document.createElement('style');
        themeStyle.textContent = '*, *::before, *::after { transition: none !important; }';
        button.addEventListener('click', () => {
          document.head.append(themeStyle);
          root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('promptsbaba-theme', root.dataset.theme); } catch {}
          sync();
          getComputedStyle(root).color;
          requestAnimationFrame(() => requestAnimationFrame(() => themeStyle.remove()));
        });
        document.addEventListener('keydown', (event) => {
          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); location.href = '/search'; }
        });
        const menus = [...document.querySelectorAll('.header-disclosure')];
        const closeMenu = (menu, restoreFocus = false) => {
          menu.removeAttribute('open');
          if (restoreFocus) menu.querySelector('summary').focus();
        };
        document.addEventListener('click', (event) => {
          menus.forEach((menu) => {
            if (!menu.contains(event.target)) closeMenu(menu);
            else if (event.target.closest('a')) closeMenu(menu);
          });
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') menus.filter((menu) => menu.open).forEach((menu) => closeMenu(menu, true));
        });
        document.addEventListener('focusin', (event) => {
          menus.forEach((menu) => { if (!menu.contains(event.target)) closeMenu(menu); });
        });
        matchMedia('(min-width: 1100px)').addEventListener('change', () => {
          menus.forEach((menu) => {
            const hadFocus = menu.contains(document.activeElement);
            closeMenu(menu);
            if (hadFocus) document.querySelector('.header-brand').focus();
          });
        });
        const shortcut = document.querySelector('.search-shortcut kbd');
        if (!/Mac|iPhone|iPad/.test(navigator.platform)) shortcut.textContent = 'Ctrl K';
        sync();
      })();
    </script>
  </body>
</html>
