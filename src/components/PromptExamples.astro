---
import { sources } from '../lib/data';
interface Props {
  entries?: { slug: string; title: string; source: string; sameMedia: boolean }[];
  currentSlug: string;
  base: string;
  kind: 'image' | 'video' | 'text';
}
const { entries = [], currentSlug, base, kind } = Astro.props;
const others = entries.filter(entry => entry.slug !== currentSlug);
---
{others.length > 0 && (
  <section class="prompt-source-examples rounded-xl border border-line bg-surface p-5">
    <h2 class="font-display text-lg font-bold">Compare source examples</h2>
    <p class="mt-2 text-sm leading-relaxed text-muted">These records share the same prompt text. Compare their {kind === 'text' ? 'source credits' : 'previews and source credits'} before choosing an example.</p>
    <ul class="mt-3 space-y-3">
      {others.map(entry => <li><a class="link text-sm font-semibold" href={`${base}${entry.slug}`}>{entry.title}</a><p class="mt-1 text-xs text-muted">{sources[entry.source].name}{kind !== 'text' && entry.sameMedia && ' · Shared sample'}</p></li>)}
    </ul>
  </section>
)}
